      "a63bf70a-7eeb-5133-92d7-b649faa1141e": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request rate per service (R)",
            "description": "Incoming requests per second (SERVER spans), per service."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "traces",
                    "source": "",
                    "aggregations": [
                      {
                        "expression": "rate()"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "serviceName IN ('fundoo-api-gateway','fundoo-user-api','fundoo-notes-api','fundoo-notification-api') AND spanKind = 'Server'"
                    },
                    "groupBy": [
                      {
                        "name": "serviceName",
                        "signal": "",
                        "fieldContext": "",
                        "fieldDataType": "string"
                      }
                    ],
                    "order": [],
                    "having": {
                      "expression": ""
                    },
                    "functions": [],
                    "legend": "{{serviceName}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
