{
  "info": {
    "_postman_id": "bf4c4ea9-05c8-5c54-bd76-013e70fc0f34",
    "name": "Fundoo Microservices",
    "description": "All APIs found in FundoMicroservices.\n\nFlow: Register -> Login (OTP emailed) -> set `otpCode` -> Verify 2FA (saves `accessToken`) -> Notes/Labels.\n`baseUrl` points at the Ocelot API Gateway (routes /api/auth, /api/notes, /api/labels).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User Service - Auth",
      "description": "Fundoo.User.Api \u2014 `api/auth/*`. Anonymous endpoints.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates an account (BCrypt-hashed password). No email is sent at registration.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [200, 201, 400, 409]', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login always triggers an emailed OTP (2FA). Put the code into `otpCode` and run **Verify 2FA**.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [200]', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const j = pm.response.json();",
                  "if (j.userId) pm.collectionVariables.set('userId', j.userId);",
                  "if (j.accessToken) pm.collectionVariables.set('accessToken', j.accessToken);",
                  "if (j.requiresTwoFactor) console.log('2FA required: copy the OTP from the email into the otpCode variable, then run Verify 2FA');"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify 2FA (OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/2fa/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "2fa",
                "verify"
              ]
            },
            "description": "Exchanges the emailed OTP for a JWT; saves it to `accessToken`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [200]', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const j = pm.response.json();",
                  "pm.test('access token issued', () => pm.expect(j.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('accessToken', j.accessToken);",
                  "if (j.userId) pm.collectionVariables.set('userId', j.userId);"
                ]
              }
            }
          ]
        },
