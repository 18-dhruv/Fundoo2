{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "fundoo-user-api",
    "Audience": "fundoo-clients",
    "ExpiryMinutes": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topics": {
      "NoteCreated": "notes.created.v1",
      "NoteUpdated": "notes.updated.v1"
    }
  }
}
